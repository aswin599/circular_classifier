# Database
DATABASE_URL="mongodb://127.0.0.1:27017/circulars_db"

# Email (IMAP)
# Training mailbox the classifier is trained on (new circulars here are shown live)
EMAIL_HOST="imap.gmail.com"
EMAIL_PORT=993
EMAIL_USER="circularclassifier@gmail.com"
EMAIL_PASSWORD="your-app-specific-password"
EMAIL_TLS=true
EMAIL_LABEL="circulars"
EMAIL_WATCH_INTERVAL=60000

# Auth
JWT_SECRET="change-this-to-a-random-32-char-string-at-least"
JWT_REFRESH_SECRET="change-this-to-another-random-32-char-string"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# App
NODE_ENV="development"
PORT=5000
CLIENT_URL="http://localhost:5173"

# Students only see circulars received from this tutor mailbox
STUDENT_TUTOR_EMAIL="aasswwiinn987@gmail.com"

# File Storage
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760

# OCR (Python + Tesseract for scanned PDFs/images; tesseract.js is the fallback)
# Requires: Python 3.13+ with `pip install pymupdf pytesseract`, plus a system
# Tesseract install (https://github.com/UB-Mannheim/tesseract/wiki). On Windows
# the default interpreter is `py -3.13`.
# OCR_PYTHON_EXE="py -3.13"
# OCR_PYTHON_SCRIPT="./server/python/ocr_extract.py"
# TESSERACT_CMD="C:/Program Files/Tesseract-OCR/tesseract.exe"
# OCR_DPI=300
# OCR_TIMEOUT_MS=180000
TESSERACT_LANG="eng"

# Google OAuth (Sign in with Google + Gmail access)
# Create credentials at https://console.cloud.google.com/apis/credentials
# Add authorized redirect URI: http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:5000/api/auth/google/callback"

# Web Push Notifications (deadline reminders)
# Generate VAPID keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
# Contact email / URL for the push service, e.g. "mailto:admin@example.com"
VAPID_SUBJECT="mailto:admin@example.com"
# Cron schedule for the daily deadline reminder job (default: 9:00 AM server time)
# To run once at boot for testing: set RUN_REMINDER_ONCE=1
REMINDER_CRON="0 9 * * *"
